# Two separate Supabase projects — DEV and PROD. The Admin Dashboard
# switches between them at runtime (Settings → Environment, or the header's
# environment pill); both pairs must be filled in for the app to start, even
# if you only use one today. Copy this file to .env.local and fill in real
# values (never commit .env.local).
#
# DEV and PROD are never derived from one another and never share a
# variable — each is its own URL + publishable key + secret key, so there is
# no code path where a request can end up with credentials from two
# different projects at once.

NEXT_PUBLIC_SUPABASE_URL_DEV=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY_DEV=
# Bypasses RLS — server-only (src/core/db/service-client.ts). Never
# NEXT_PUBLIC_*, never logged, never sent to the client.
SUPABASE_SECRET_KEY_DEV=

NEXT_PUBLIC_SUPABASE_URL_PROD=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY_PROD=
# Bypasses RLS — server-only (src/core/db/service-client.ts). Never
# NEXT_PUBLIC_*, never logged, never sent to the client.
SUPABASE_SECRET_KEY_PROD=

# Gym-owner invitation email (Onboard gym). Optional — without these the gym
# is still created and the admin is told to use "Resend invitation" later.
# Resend SMTP: host smtp.resend.com, port 465, user "resend", password = your
# Resend API key. EMAIL_FROM must be on a domain verified in Resend.
RESEND_SMTP_HOST=smtp.resend.com
RESEND_SMTP_PORT=465
RESEND_SMTP_USER=resend
RESEND_SMTP_PASSWORD=
EMAIL_FROM=no-reply@myfitdesk.app
EMAIL_FROM_NAME=MyFitDesk
# Where the invite link lands (the tenant app). Defaults to https://myfitdesk.vercel.app
MYFITDESK_ORIGIN=

# Public Book Demo is pinned by server config, NEVER the admin-env cookie.
# DEV = pgedlnxuuelmtpmbkdwm; PROD = clbphruocsqsmklmrloq.
# Unset: prod on Vercel production deployments, dev elsewhere.
# For a live deployment with this variable set, set it explicitly to prod.
BOOK_DEMO_ENVIRONMENT=dev
MARKETING_ORIGIN=https://www.myfitdesk.app
# Confirm/configure the actual support mailbox before launching publicly.
BOOK_DEMO_SUPPORT_EMAIL=hello@myfitdesk.com
# Optional sales notification recipient; no recipient is guessed when blank.
BOOK_DEMO_SALES_EMAIL=
# Self-hosting only: true requires a proxy that strips/overwrites X-Forwarded-For.
BOOK_DEMO_TRUST_PROXY=false

# Gym-logo storage — Cloudflare R2. Optional: without these, logos go to
# Supabase Storage ("gym-logos" bucket). Same variable names as FitDeskApp, and
# the values (esp. R2_STORAGE_ROLLOUT_MODE / AVATAR_STORAGE_PROVIDER) must match
# the TENANT deployment, since logos are served from whichever bucket it reads.
# R2_ACCOUNT_ID=
# Legacy bucket (also needs R2_LEGACY_PUBLIC_URL_BASE for a durable public URL):
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_LEGACY_PUBLIC_URL_BASE=
# New public bucket (used in mirror / prefer-target / target modes):
# R2_PUBLIC_BUCKET_NAME=
# R2_PUBLIC_ACCESS_KEY_ID=
# R2_PUBLIC_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL_BASE=
# Private bucket — READ-ONLY here, used only to show member profile pictures
# (presigned GETs). Needed when the tenant app's R2_STORAGE_ROLLOUT_MODE is
# prefer-target or target.
# R2_PRIVATE_BUCKET_NAME=
# R2_PRIVATE_ACCESS_KEY_ID=
# R2_PRIVATE_SECRET_ACCESS_KEY=
# AVATAR_STORAGE_PROVIDER=auto
# R2_STORAGE_ROLLOUT_MODE=legacy

# Database disaster recovery. The R2 and PostgreSQL values themselves belong
# in GitHub Environment secrets (development / production), never in a
# NEXT_PUBLIC_* variable. These optional server-only values let the admin app
# dispatch a workflow immediately after it safely queues a request.
BACKUP_GITHUB_TOKEN=
BACKUP_GITHUB_REPOSITORY=owner/admin-myfitdesk
BACKUP_GITHUB_REF=main
# Bearer secret for GET /api/cron/backup (the reliable hourly trigger). Generate
# a long random value; without it the route refuses every call.
CRON_SECRET=

# Managed platform inbox: server-only, explicitly paired with each database.
# DEV and PROD may use different numbers; do not copy a live token into DEV.
WHATSAPP_MANAGED_WABA_ID_DEV=
WHATSAPP_MANAGED_PHONE_NUMBER_ID_DEV=
WHATSAPP_MANAGED_ACCESS_TOKEN_DEV=
WHATSAPP_MANAGED_WABA_ID_PROD=
WHATSAPP_MANAGED_PHONE_NUMBER_ID_PROD=
WHATSAPP_MANAGED_ACCESS_TOKEN_PROD=
# Optional token fallbacks: WHATSAPP_SYSTEM_USER_TOKEN_DEV / _PROD.
META_GRAPH_API_VERSION=v21.0

# Required GitHub Environment secrets in BOTH `development` and `production`:
# BACKUP_DATABASE_IDENTIFIER=unique-project-ref-or-label
# BACKUP_SUPABASE_DB_URL=postgresql://... (direct/session pooler, not transaction mode)
# BACKUP_R2_ACCOUNT_ID=
# BACKUP_R2_ACCESS_KEY_ID=
# BACKUP_R2_SECRET_ACCESS_KEY=
# BACKUP_R2_BUCKET=myfitdesk-database-backups
# BACKUP_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
